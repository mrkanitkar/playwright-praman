{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"]
    ],
    "scope-enum": [
      1,
      "always",
      [
        "core",
        "bridge",
        "proxy",
        "fixtures",
        "auth",
        "selectors",
        "matchers",
        "modules",
        "fe",
        "ai",
        "intents",
        "vocabulary",
        "reporters",
        "cli",
        "docs",
        "ci",
        "config",
        "errors",
        "logging",
        "prompts",
        "telemetry",
        "types",
        "security",
        "deps",
        "release",
        "adapter"
      ]
    ],
    "subject-max-length": [2, "always", 72],
    "body-max-line-length": [2, "always", 200],
    "header-max-length": [2, "always", 100]
  }
}
