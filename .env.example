# ─────────────────────────────────────────────────────────────────────────────
# Praman v1.0 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env — it is gitignored
# ─────────────────────────────────────────────────────────────────────────────

# ── SAP BTP Cloud Authentication (used by seed files directly) ──────────────
SAP_CLOUD_BASE_URL=https://your-sap-system.example.com
SAP_CLOUD_USERNAME=
SAP_CLOUD_PASSWORD=
SAP_AUTH_STRATEGY=btp-saml
SAP_CLIENT=100
SAP_LANGUAGE=EN

# ── Praman Config Overrides (top-level) ────────────────────────────────────
PRAMAN_LOG_LEVEL=info
PRAMAN_INTERACTION_STRATEGY=ui5-native
# PRAMAN_UI5_WAIT_TIMEOUT=30000
# PRAMAN_CONTROL_DISCOVERY_TIMEOUT=10000
# PRAMAN_SKIP_STABILITY_WAIT=false
# PRAMAN_PREFER_VISIBLE=true
# PRAMAN_DEBUG=true

# ── Praman Auth Config (maps to config.auth.*) ────────────────────────────
# PRAMAN_AUTH_BASE_URL=https://your-sap-system.example.com
# PRAMAN_AUTH_STRATEGY=basic
# PRAMAN_AUTH_USERNAME=
# PRAMAN_AUTH_PASSWORD=
# PRAMAN_AUTH_CLIENT=100
# PRAMAN_AUTH_LANGUAGE=EN

# ── Praman AI Config (maps to config.ai.*) ────────────────────────────────
PRAMAN_AI_PROVIDER=azure-openai
PRAMAN_AI_API_KEY=
PRAMAN_AI_ENDPOINT=
# PRAMAN_AI_MODEL=
# PRAMAN_AI_TEMPERATURE=0.3
# PRAMAN_AI_DEPLOYMENT=
# PRAMAN_AI_API_VERSION=
# PRAMAN_AI_ANTHROPIC_API_KEY=

# ── Praman Telemetry Config (maps to config.telemetry.*) ──────────────────
# PRAMAN_TELEMETRY_ENABLED=false
# PRAMAN_TELEMETRY_ENDPOINT=
# PRAMAN_TELEMETRY_SERVICE_NAME=playwright-praman

# ── Praman OData Tracing Config (maps to config.odataTracing.*) ───────────
# PRAMAN_ODATA_TRACING_ENABLED=false

# ── npm Publishing (CI only — do NOT commit actual values) ─────────────────
NPM_TOKEN=
