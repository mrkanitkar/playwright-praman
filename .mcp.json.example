{
  "mcpServers": {
    "playwright-test": {
      "command": "npx",
      "args": [
        "playwright",
        "run-test-mcp-server"
      ]
    },
    "ui5-mcp": {
      "command": "npx",
      "args": ["@ui5/mcp-server"],
      "env": {
        "UI5_MCP_WORKSPACE": "/path/to/your/project"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    }
  }
}
