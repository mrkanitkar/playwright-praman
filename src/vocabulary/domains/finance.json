        "fiscalPeriod": {
          "labelFor": { "text": "Fiscal Period" },
          "intentApiMethod": "searchAndSelectFromValueHelp",
          "hasValueHelp": true,
          "businessContext": "accounting period",
          "sapFieldName": "MONAT",
          "aliases": ["MONAT", "period"]
        }
      },
      "item": {
        "glAccount": {
          "labelFor": { "text": "G/L Account" },
