          "businessContext": "date of the source document",
          "sapFieldName": "BLDAT",
          "aliases": ["BLDAT", "invoiceDate"]
        },
        "postingDate": {
          "labelFor": { "text": "Posting Date" },
          "intentApiMethod": "fillInputField",
          "hasValueHelp": false,
          "businessContext": "date for financial posting",
          "sapFieldName": "BUDAT",
          "aliases": ["BUDAT"]
        },
        "documentType": {
          "labelFor": { "text": "Document Type" },
          "intentApiMethod": "searchAndSelectFromValueHelp",
          "hasValueHelp": true,
          "businessContext": "type of accounting document",
          "sapFieldName": "BLART",
          "aliases": ["BLART"]
        },
        "currency": {
          "labelFor": { "text": "Currency" },
          "intentApiMethod": "searchAndSelectFromValueHelp",
          "hasValueHelp": true,
          "businessContext": "document currency",
          "sapFieldName": "WAERS",
          "aliases": ["WAERS"]
        },
        "fiscalYear": {
          "labelFor": { "text": "Fiscal Year" },
