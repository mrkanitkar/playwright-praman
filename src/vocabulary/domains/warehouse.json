          "sapFieldName": "BWART",
          "aliases": ["BWART"]
        },
        "plant": {
          "labelFor": { "text": "Plant" },
          "intentApiMethod": "searchAndSelectFromValueHelp",
          "hasValueHelp": true,
          "businessContext": "plant for goods movement",
          "sapFieldName": "WERKS",
          "aliases": ["WERKS"]
        },
        "storageLocation": {
          "labelFor": { "text": "Storage Location" },
