{
  "$version": "1.2.0",
  "$description": "Asset Management domain vocabulary with labelFor-based selectors for Intent API v1.2.0",
  "domain": "asset-management",
  "module": "FI-AA",
  "ui5Selectors": {
    "assetAcquisition": {
      "header": {
        "assetClass": {
          "labelFor": { "text": "Asset Class" },
          "intentApiMethod": "searchAndSelectFromValueHelp",
          "hasValueHelp": true,
          "businessContext": "asset class for grouping fixed assets",
          "sapFieldName": "ANLKL",
          "aliases": ["ANLKL", "class"]
        },
        "description": {
          "labelFor": { "text": "Description" },
          "intentApiMethod": "fillInputField",
          "hasValueHelp": false,
          "businessContext": "short description of the asset",
          "sapFieldName": "TXT50",
          "aliases": ["TXT50", "name"]
        },
        "acquisitionValue": {
          "labelFor": { "text": "Acquisition Value" },
          "intentApiMethod": "fillInputField",
          "hasValueHelp": false,
          "businessContext": "capitalized acquisition amount",
          "sapFieldName": "ANSWL",
          "aliases": ["ANSWL", "value"]
        },
        "capitalizationDate": {
          "labelFor": { "text": "Capitalization Date" },
          "intentApiMethod": "fillInputField",
          "hasValueHelp": false,
          "businessContext": "date of asset capitalization",
          "sapFieldName": "AKTIV",
          "aliases": ["AKTIV"]
        },
        "costCenter": {
          "labelFor": { "text": "Cost Center" },
          "intentApiMethod": "searchAndSelectFromValueHelp",
          "hasValueHelp": true,
          "businessContext": "cost center responsible for the asset",
          "sapFieldName": "KOSTL",
          "aliases": ["KOSTL"]
        }
      },
      "actions": {
        "save": {
          "controlType": "sap.m.Button",
          "properties": { "text": "Save" },
          "intentApiMethod": "clickButton"
        }
      }
    },
    "assetRetirement": {
      "header": {
        "assetNumber": {
          "labelFor": { "text": "Asset Number" },
          "intentApiMethod": "searchAndSelectFromValueHelp",
          "hasValueHelp": true,
          "businessContext": "main asset number to retire",
          "sapFieldName": "ANLN1",
          "aliases": ["ANLN1", "asset"]
        },
        "retirementDate": {
          "labelFor": { "text": "Retirement Date" },
          "intentApiMethod": "fillInputField",
          "hasValueHelp": false,
          "businessContext": "date the asset is retired",
          "sapFieldName": "BZDAT",
          "aliases": ["BZDAT"]
        },
        "revenue": {
          "labelFor": { "text": "Revenue" },
          "intentApiMethod": "fillInputField",
          "hasValueHelp": false,
          "businessContext": "sale revenue (zero for scrapping)",
          "sapFieldName": "ANBTR",
          "aliases": ["ANBTR", "proceeds"]
        }
      },
      "actions": {
        "save": {
          "controlType": "sap.m.Button",
          "properties": { "text": "Save" },
          "intentApiMethod": "clickButton"
        }
      }
    },
    "assetTransfer": {
      "header": {
        "sourceAsset": {
          "labelFor": { "text": "Source Asset" },
          "intentApiMethod": "searchAndSelectFromValueHelp",
          "hasValueHelp": true,
          "businessContext": "asset to transfer from",
          "sapFieldName": "ANLN1",
          "aliases": ["ANLN1", "from"]
        },
        "targetAsset": {
          "labelFor": { "text": "Target Asset" },
          "intentApiMethod": "searchAndSelectFromValueHelp",
          "hasValueHelp": true,
          "businessContext": "asset to transfer to",
          "sapFieldName": "ANLN2",
          "aliases": ["ANLN2", "to"]
        },
        "transferDate": {
          "labelFor": { "text": "Transfer Date" },
          "intentApiMethod": "fillInputField",
          "hasValueHelp": false,
          "businessContext": "date of asset transfer",
          "sapFieldName": "BZDAT",
          "aliases": ["BZDAT"]
        },
        "amount": {
          "labelFor": { "text": "Amount" },
          "intentApiMethod": "fillInputField",
          "hasValueHelp": false,
          "businessContext": "partial transfer amount",
          "sapFieldName": "ANBTR",
          "aliases": ["ANBTR"]
        }
      },
      "actions": {
        "save": {
          "controlType": "sap.m.Button",
          "properties": { "text": "Save" },
          "intentApiMethod": "clickButton"
        }
      }
    }
  },
  "businessTermMappings": {
    "class": "assetClass",
    "name": "description",
    "value": "acquisitionValue",
    "asset": "assetNumber",
    "proceeds": "revenue",
    "from": "sourceAsset",
    "to": "targetAsset"
  }
}
