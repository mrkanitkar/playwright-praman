* text=auto eol=lf
*.ts linguist-language=TypeScript
*.md diff=markdown
*.json diff=json

# Ensure LF line endings for shell scripts (Husky hooks, CI scripts)
*.sh text eol=lf
.husky/* text eol=lf

# Exclude generated files from language statistics
src/proxy/typed/*.generated.ts linguist-generated=true
docs/build/** linguist-generated=true
skills/playwright-praman-sap-testing/SKILL.md linguist-generated=true
*.sbom.json linguist-generated=true
