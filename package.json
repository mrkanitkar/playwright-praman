{
  "name": "playwright-praman",
  "version": "1.3.3",
  "description": "Playwright plugin for SAP S/4HANA, Fiori & UI5 test automation — AI test generation, 199 typed control proxies, OData V2/V4, Fiori Elements, 6 auth strategies",
  "author": {
    "name": "Maheshwar Kanitkar",
    "email": "support@zestest.in",
    "url": "https://praman.dev"
  },
  "license": "Apache-2.0",
  "imports": {
    "#ai/*": "./src/ai/*",
    "#bridge/*": "./src/bridge/*",
    "#core/*": "./src/core/*",
    "#extensions/*": "./src/extensions/*",
    "#fixtures/*": "./src/fixtures/*",
    "#intents/*": "./src/intents/*",
    "#proxy/*": "./src/proxy/*",
    "#vocabulary/*": "./src/vocabulary/*"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills/",
    "agents/",
    "docs/user-integration/",
    "examples/",
    "seeds/",
    "specs/",
    "prompts/",
    ".env.example",
    "capabilities.yaml",
    "capabilities.json",
    "recipes.yaml",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "README.md",
    "DISCLAIMER.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": {
        "import": "./dist/ai/index.d.ts",
        "require": "./dist/ai/index.d.cts"
      },
      "import": "./dist/ai/index.js",
      "require": "./dist/ai/index.cjs",
      "default": "./dist/ai/index.js"
    },
    "./intents": {
      "types": {
        "import": "./dist/intents/index.d.ts",
        "require": "./dist/intents/index.d.cts"
      },
      "import": "./dist/intents/index.js",
      "require": "./dist/intents/index.cjs",
      "default": "./dist/intents/index.js"
    },
    "./vocabulary": {
      "types": {
        "import": "./dist/vocabulary/index.d.ts",
        "require": "./dist/vocabulary/index.d.cts"
      },
      "import": "./dist/vocabulary/index.js",
      "require": "./dist/vocabulary/index.cjs",
      "default": "./dist/vocabulary/index.js"
    },
    "./fe": {
      "types": {
        "import": "./dist/fe/index.d.ts",
        "require": "./dist/fe/index.d.cts"
      },
      "import": "./dist/fe/index.js",
      "require": "./dist/fe/index.cjs",
      "default": "./dist/fe/index.js"
    },
    "./reporters": {
      "types": {
        "import": "./dist/reporters/index.d.ts",
        "require": "./dist/reporters/index.d.cts"
      },
      "import": "./dist/reporters/index.js",
      "require": "./dist/reporters/index.cjs",
      "default": "./dist/reporters/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "playwright-praman": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup && tsx scripts/build-browser-bundles.ts",
    "dev": "tsup --watch",
    "clean": "node -e \"['dist','coverage','playwright-report','test-results','.auth'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "check:exports": "attw --pack . --ignore-rules no-resolution",
    "lint": "eslint src/ tests/ --max-warnings=0 --rule 'praman/no-deprecated-ui5-globals: off' --rule 'praman/no-deprecated-ui5-api: off'",
    "lint:fix": "eslint src/ tests/ --fix --max-warnings=0 --rule 'praman/no-deprecated-ui5-globals: off' --rule 'praman/no-deprecated-ui5-api: off'",
    "lint:ui5-deprecated": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "spellcheck": "cspell \"src/**/*.ts\" \"docs/**/*.md\" --no-progress",
    "deadcode": "knip",
    "mdlint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#docs/build\"",
    "validate:capabilities": "tsx scripts/validate-capabilities.ts",
    "validate:no-js": "tsx scripts/check-no-js-in-src.ts",
    "validate:prompts": "tsx scripts/validate-prompts.ts",
    "test:ai-integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "playwright test",
    "test:integration:demo": "playwright test --config tests/integration/playwright.integration.config.ts",
    "test:integration:ui": "playwright test --ui",
    "ci": "npm run validate:no-js && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run lint:ui5-deprecated && npm run validate:capabilities",
    "ci:full": "npm run ci && npm run test:integration && npm run spellcheck && npm run deadcode && npm run mdlint",
    "docs:dev": "cd docs && npx docusaurus start",
    "docs:build": "cd docs && npx docusaurus build",
    "docs:api": "typedoc",
    "docs:api-html": "typedoc --options typedoc-html.json",
    "docs:api-review": "api-extractor run --local --verbose",
    "docs:validate": "npm run docs:api && npm run lint && npm run typecheck",
    "generate:capabilities": "tsx scripts/generate-capabilities.ts",
    "generate:skill-md": "tsx scripts/generate-skill-md.ts",
    "generate:skill": "tsx scripts/generate-skill-md.ts",
    "validate:skill-md": "tsx scripts/validate-skill-md.ts",
    "docs:verify": "tsx scripts/docs-verify/index.ts --mode=full",
    "docs:verify:pr": "tsx scripts/docs-verify/index.ts --mode=pr",
    "docs:verify:doc": "tsx scripts/docs-verify/index.ts --doc",
    "build:browser": "tsx scripts/build-browser-bundles.ts",
    "build:full": "npm run generate:capabilities && npm run generate:skill-md && npm run build && npm run generate:llms-txt",
    "generate:proxies": "tsx scripts/generate-typed-proxies.ts",
    "generate:sbom": "cyclonedx-npm --output-file playwright-praman.sbom.json --spec-version 1.5 --ignore-npm-errors",
    "generate:llms-txt": "tsx scripts/generate-llms-txt.ts",
    "generate:schema": "tsx scripts/generate-json-schema.ts",
    "setup:ide": "tsx scripts/setup-ide.ts",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "prepublishOnly": "npm run ci",
    "preuninstall": "node dist/cli/preuninstall.js",
    "prepare": "husky"
  },
  "dependencies": {
    "commander": "15.0.0",
    "css-selector-parser": "3.3.0",
    "fontoxpath": "3.34.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.78.0",
    "@azure/monitor-opentelemetry-exporter": ">=1.0.0-beta.28",
    "@opentelemetry/api": ">=1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": ">=0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.214.0",
    "@opentelemetry/sdk-metrics": ">=2.6.0",
    "@opentelemetry/sdk-node": ">=0.212.0",
    "@playwright/cli": ">=0.1.3",
    "@playwright/test": ">=1.57.0 <2.0.0",
    "openai": ">=6.22.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@azure/monitor-opentelemetry-exporter": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@playwright/cli": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "overrides": {
    "picomatch@2.3.1": "2.3.2",
    "picomatch@4.0.3": "4.0.4",
    "smol-toml@<1.6.1": "1.6.1",
    "@microsoft/eslint-plugin-sdl": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.100.1",
    "@arethetypeswrong/cli": "0.18.3",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@cyclonedx/cyclonedx-npm": "4.2.1",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.58.7",
    "@microsoft/eslint-plugin-sdl": "1.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-metrics": "2.7.1",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@playwright/cli": "0.1.13",
    "@playwright/test": "1.60.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@size-limit/file": "12.1.0",
    "@ui5/mcp-server": "0.2.12",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "cspell": "10.0.1",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-headers": "1.3.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-n": "18.0.1",
    "eslint-plugin-playwright": "2.10.4",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unicorn": "64.0.0",
    "execa": "9.6.1",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "knip": "6.15.0",
    "lint-staged": "17.0.7",
    "markdownlint-cli2": "0.22.1",
    "openai": "6.41.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.3",
    "release-please": "17.7.0",
    "size-limit": "12.1.0",
    "ts-morph": "28.0.0",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "6.0.3",
    "typescript-docs-verifier": "3.0.2",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8",
    "yaml": "2.9.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "keywords": [
    "playwright",
    "playwright-plugin",
    "playwright-test",
    "sap",
    "ui5",
    "sapui5",
    "openui5",
    "fiori",
    "fiori-elements",
    "s4hana",
    "btp",
    "odata",
    "testing",
    "test-automation",
    "automation",
    "e2e",
    "e2e-testing",
    "regression",
    "regression-testing",
    "ai",
    "ai-testing",
    "ai-first",
    "agentic",
    "wdi5",
    "sap-testing",
    "sap-automation",
    "sap-fiori",
    "sap-e2e-testing",
    "test-generation",
    "enterprise",
    "erp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrkanitkar/playwright-praman.git"
  },
  "bugs": {
    "url": "https://github.com/mrkanitkar/playwright-praman/issues"
  },
  "homepage": "https://praman.dev",
  "allowScripts": {
    "esbuild@0.28.0": true,
    "esbuild@0.27.7": true,
    "protobufjs@7.6.1": true
  }
}
